#!/bin/bash

# omarchy:summary=Report whether another Omarchy shell on this display holds the session lock
# omarchy:args=<own-pid>
# omarchy:hidden=true

# Hyprland only says that the session is locked, not by whom, and with
# misc:allow_session_lock_restore it hands the lock to whichever client asks
# next. A second shell on the same display (a test copy, a dev checkout) that
# took a healthy lock for a stranded one would therefore steal it, and leave
# the lockdead failsafe up once it exits. Ask every other shell instead.
#
# Exits 0 and prints the holder's config path when another shell reports the
# lock secure or in progress, 1 otherwise. An instance that does not answer
# holds nothing worth preserving.
own_pid=${1:-}

instances=$(quickshell list --all --json 2>/dev/null |
  jq -r '.[] | [.pid, .config_path] | @tsv' 2>/dev/null)

while IFS=$'\t' read -r pid config_path; do
  [[ -n $pid && $pid != "$own_pid" ]] || continue
  [[ $config_path == */shell/shell.qml ]] || continue

  holding=$(OMARCHY_PATH="${config_path%/shell/shell.qml}" OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell lock status 2>/dev/null |
    jq -r '.secure or .requested' 2>/dev/null)

  if [[ $holding == "true" ]]; then
    echo "$config_path"
    exit 0
  fi
done <<<"$instances"

exit 1
