#!/bin/bash

# omarchy:summary=Report whether the calling shell is the one the session runs
# omarchy:args=<shell-pid>
# omarchy:hidden=true

# Other shells share the session's display: test copies, a checkout run by
# hand, a duplicate started without -n. None of them may act for the session,
# since Hyprland hands its lock to whichever client asks last and a short-lived
# shell taking it leaves the lockdead failsafe up once it exits. The user
# manager carries the session's OMARCHY_PATH, the one omarchy-restart-shell
# relaunches from, and of several shells from that tree on this display the
# oldest one is the session's.
#
# Exits 0 for the session's shell, or when the session records no path to
# compare against; 1 for a shell from another tree; 2 for a duplicate that
# would become the session's shell once the older one is gone.
shell_pid=${1:-}

# The manager's raw environment, since show-environment escapes values that
# hold spaces or other shell syntax.
session_path=$(busctl --user --json=short get-property org.freedesktop.systemd1 /org/freedesktop/systemd1 \
  org.freedesktop.systemd1.Manager Environment 2>/dev/null |
  jq -r '.data[] | select(startswith("OMARCHY_PATH=")) | ltrimstr("OMARCHY_PATH=")' 2>/dev/null | tail -n 1)

if [[ -n $session_path && $(realpath -m -- "$session_path") != "$(realpath -m -- "${OMARCHY_PATH:-}")" ]]; then
  exit 1
fi

# Clock ticks since boot: unlike Quickshell's wall-clock launch time, these
# keep their order when the clock moves back.
start_ticks() {
  local stat fields
  { stat=$(<"/proc/$1/stat"); } 2>/dev/null || return 1
  read -ra fields <<<"${stat##*) }"
  echo "${fields[19]}"
}

own_start=$(start_ticks "$shell_pid") || exit 0

# Listing by config path keeps to this display.
while read -r pid; do
  [[ -n $pid && $pid != "$shell_pid" ]] || continue
  start=$(start_ticks "$pid") || continue

  if (( start < own_start || (start == own_start && pid < shell_pid) )); then
    exit 2
  fi
done < <(quickshell list -p "${OMARCHY_PATH:-}/shell" --json 2>/dev/null | jq -r '.[].pid' 2>/dev/null)

exit 0
